# ─── Mindfulness Olavarría — Variables de entorno ────────────────────────────
# Copiá este archivo como .env y completá los valores reales
# NUNCA subas .env a git

APP_NAME="Mindfulness Olavarría"
DEBUG=True

# IMPORTANTE: Cambiá esto antes de producción
# Generá una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_en_produccion_por_una_clave_muy_larga_y_aleatoria

# Base de datos (SQLite para desarrollo)
DATABASE_URL=sqlite:///./mindfulness_olavarria.db

# Para producción usar PostgreSQL:
# DATABASE_URL=postgresql://usuario:password@localhost:5432/mindfulness_db

# CORS - URLs del frontend
# En desarrollo:
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Planes de precios (en pesos argentinos) — valores de ejemplo
PRICE_MONTHLY_ARS=2990.0
PRICE_QUARTERLY_ARS=7990.0
PRICE_YEARLY_ARS=29900.0
FREE_TRIAL_DAYS=7

# ─── MercadoPago (Suscripciones / Preapproval) ────────────────────────────────
# Reemplazar por las credenciales REALES cuando Gabriela las tenga
# Obtenerlas en: mercadopago.com.ar/developers → Mis aplicaciones → Credenciales

# Credenciales de PRODUCCIÓN (las reales):
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_PUBLIC_KEY=APP_USR-00000000-0000-0000-0000-000000000000

# URLs de retorno (cambiar por el dominio real en producción)
MP_SUCCESS_URL=http://localhost:5173/suscripcion/exitosa
MP_FAILURE_URL=http://localhost:5173/suscripcion/fallida
MP_PENDING_URL=http://localhost:5173/suscripcion/pendiente
MP_WEBHOOK_URL=http://localhost:8000/api/v1/payments/webhook
